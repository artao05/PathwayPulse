# Paste into Streamlit Community Cloud: Manage app → Settings → Secrets
# Do NOT commit a real secrets.toml file to GitHub.
#
# IMPORTANT: use flat keys (no [section] headers). Example:

OPENAI_API_KEY = "sk-..."
AIMLAPI_KEY = "..."
XAI_API_KEY = "xai-..."

# Optional — PubMed/OpenAlex Phase 2 enrichment.
NCBI_API_KEY = ""
USER_EMAIL = ""
OPENALEX_API_KEY = ""

# Optional — enables BrightData conference abstract scraping.
# Playwright connects to BrightData's remote browser (no local Chromium needed).
BRIGHTDATA_BROWSER_AUTH = "brd-customer-XXXX-zone-scraping_browser:XXXX"
