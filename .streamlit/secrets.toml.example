# Copy these keys into Streamlit Community Cloud:
# App → Settings → Secrets
#
# Do NOT commit a real secrets.toml file to GitHub.

OPENAI_API_KEY = "sk-..."
AIMLAPI_KEY = "..."
XAI_API_KEY = "xai-..."

# Optional — enables ACR/ASCO conference scraping and ClinicalTrials.gov text records.
# Playwright connects to BrightData's remote browser (no local Chromium needed).
BRIGHTDATA_BROWSER_AUTH = "brd-customer-XXXX-zone-scraping_browser:XXXX"
