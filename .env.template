# PathwayPulse — API Keys Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── OpenAI (Executioner — gpt-4o heavy reasoning) ───────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-replace-with-your-openai-key

# ── AI/ML API (Synthesizer — DeepSeek-V3 high-throughput) ───────────────────
# https://aimlapi.com  →  API Keys
AIMLAPI_KEY=replace-with-your-aimlapi-key

# ── Bright Data Scraping Browser ─────────────────────────────────────────────
# https://brightdata.com  →  Scraping Browser  →  Access Parameters
# Format: username:password   (used in wss://${BRIGHTDATA_BROWSER_AUTH}@brd.superproxy.io:9222)
BRIGHTDATA_BROWSER_AUTH=brd-customer-XXXX-zone-scraping_browser:XXXX

# ── xAI Grok (KOL Twitter/X ingestion via x_search tool) ────────────────────
# https://console.x.ai  →  API Keys
# Powers the KOL handle ingestion in the sidebar. Leave blank to skip X/Twitter data.
XAI_API_KEY=replace-with-your-xai-key

# ── PubMed / OpenAlex Phase 2 enrichment (optional) ─────────────────────────
# PubMed works without a key; NCBI_API_KEY raises the E-utilities rate limit.
# USER_EMAIL identifies the app to NCBI/OpenAlex polite pools.
NCBI_API_KEY=
USER_EMAIL=

# OpenAlex works without a key at low volume; a key raises citation lookup limits.
OPENALEX_API_KEY=

# ── Twitter / X Bearer Token (DEPRECATED — superseded by XAI_API_KEY above) ─
# The free Twitter API is write-only and no longer used by PathwayPulse.
# TWITTER_BEARER_TOKEN=
