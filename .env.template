# PathwayPulse — API Keys Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── OpenAI (Executioner — gpt-4o heavy reasoning) ───────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-replace-with-your-openai-key

# ── AI/ML API (Synthesizer — DeepSeek-V3 high-throughput) ───────────────────
# https://aimlapi.com  →  API Keys
AIMLAPI_KEY=replace-with-your-aimlapi-key

# ── Bright Data Scraping Browser ─────────────────────────────────────────────
# https://brightdata.com  →  Scraping Browser  →  Access Parameters
# Format: username:password   (used in wss://${BRIGHTDATA_BROWSER_AUTH}@brd.superproxy.io:9222)
BRIGHTDATA_BROWSER_AUTH=brd-customer-XXXX-zone-scraping_browser:XXXX

# ── Twitter / X  (OPTIONAL — free tier is write-only, agent returns [] if unset) ──
# https://developer.twitter.com  →  Projects & Apps  →  Bearer Token
# Requires Basic tier ($100/month) for read access. Leave blank to skip.
TWITTER_BEARER_TOKEN=
